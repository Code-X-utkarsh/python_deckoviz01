# ============================================================
# Deckoviz — .gitignore
# ============================================================

# ── Python artifacts ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.Python
build/
dist/
develop-eggs/
downloads/
sdist/
var/
wheels/
*.manifest
*.spec

# ── Virtual environments ────────────────────────────────────
venv/
.venv/
env/
ENV/
Pipfile
Pipfile.lock

# ── Environment files ───────────────────────────────────────
.env
.env.*
!.env.example
*.pem

# ── Log files ────────────────────────────────────────────────
*.log
*.log.*
logs/

# ── IDE / editor files ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── macOS / Windows system files ────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Testing artifacts ───────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Celery ───────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

# ── Database files ───────────────────────────────────────────
*.sqlite3
*.db

# ── Media / uploads ──────────────────────────────────────────
media/
configs/

# ── Django static (collected) ────────────────────────────────
/common/rest_framework/
/common/admin/
/common/staticfiles/
/output/

# ── Temporary / local files ─────────────────────────────────
temp/
tmp/
mock_data/
